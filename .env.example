# Copy to .env and adjust for your machine:
#   cp .env.example .env
# Then load it in one command:
#   set -a; source .env; set +a
#
# These values are the modest local configuration for the 20 bundled Bronze
# games (see README Quickstart). They match .github/workflows/ci.yml.

LAXPXP_SPARK_MASTER=local[2]
LAXPXP_SPARK_DRIVER_MEMORY=2g
LAXPXP_SPARK_DEFAULT_PARALLELISM=2
LAXPXP_SPARK_SHUFFLE_PARTITIONS=4
LAXPXP_DELTA_WRITE_PARTITIONS=4

# --- Optional overrides (defaults in code are fine for the demo) ---
# LAXPXP_DATA_DIR=data
# LAXPXP_GOLD_DIR=data/gold
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# LAXPXP_SPARK_EVENT_LOG_DIR=
# LAXPXP_PLAN_OUTPUT=
# LAXPXP_BENCH_METRICS=
